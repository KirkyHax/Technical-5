<IfModule mod_rewrite.c>
    RewriteEngine On

    # InfinityFree cannot change the document root from htdocs to public.
    # Serve public storage files without requiring a symbolic link.
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [END]

    # Send all other public requests through Laravel's public directory.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
